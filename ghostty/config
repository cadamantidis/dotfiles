# Ghostty config — reload with `ghostty +reload-config` or kill -USR1 <pid>

# ── Font ─────────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true

# ── Theme ────────────────────────────────────────────────────────────────────
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# ── Window ───────────────────────────────────────────────────────────────────
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-save-state = always
macos-titlebar-style = tabs
background-opacity = 0.97
background-blur = true
unfocused-split-opacity = 0.85

# ── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# ── Scrollback ───────────────────────────────────────────────────────────────
scrollback-limit = 100000

# ── macOS keys ───────────────────────────────────────────────────────────────
# Treat Option as Alt so shells get word-jump (option+←/→) and emacs-style bindings.
macos-option-as-alt = true

# ── Clipboard ────────────────────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

# ── Bell ─────────────────────────────────────────────────────────────────────
# Visual + audio bell — handy when Claude finishes a long run.
bell-features = system,attention,title

# ── Shell integration ────────────────────────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ── Confirm-close behavior ───────────────────────────────────────────────────
confirm-close-surface = true
quit-after-last-window-closed = false

# ── Quick terminal (drop-down) ───────────────────────────────────────────────
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-screen = main

# ── Claude Code: Shift+Enter inserts newline in the prompt ───────────────────
keybind = shift+enter=text:\n
# Option+Enter as a backup (works because macos-option-as-alt = true).
keybind = alt+enter=text:\n

# ── Splits ───────────────────────────────────────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# ── Prompt navigation (needs shell integration) ──────────────────────────────
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# ── Reload config without restarting ─────────────────────────────────────────
keybind = cmd+shift+comma=reload_config
