<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.happy.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HAPPY_DIR__/run-daemon.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.happy/logs/launchd-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.happy/logs/launchd-daemon.log</string>
    <!-- NOT __HOME__: a launchd process has no TCC grants of its own, so anything
         enumerating the cwd walks into Downloads/Pictures/Desktop/Documents and
         triggers a macOS permission prompt for each. Sessions get their own cwd. -->
    <key>WorkingDirectory</key>
    <string>__HOME__/.happy</string>
</dict>
</plist>
